@startuml colors-lab-use-case
title Colors Lab - use case diagram
left to right direction
skinparam shadowing false

actor "Registered user" as User
actor "MySQL database" as DB

rectangle "Colors Lab web app" {
  usecase "Log in" as UC_Login
  usecase "Show login error" as UC_Error
  usecase "Log out" as UC_Logout
  usecase "Search colors" as UC_Search
  usecase "Add color" as UC_Add
  usecase "Check login session" as UC_Session
}

User --> UC_Login
User --> UC_Logout
User --> UC_Search
User --> UC_Add

UC_Error .> UC_Login : <<extend>>
UC_Search .> UC_Session : <<include>>
UC_Add .> UC_Session : <<include>>

UC_Login -- DB
UC_Search -- DB
UC_Add -- DB

note right of UC_Error
  Shown when Login.php finds
  no matching user record
end note

note bottom of UC_Session
  readCookie() redirects to
  index.html if no userId cookie
end note
@enduml
